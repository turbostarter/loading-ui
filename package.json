{
  "name": "loading-ui",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://loading-ui.com",
  "bugs": {
    "url": "https://github.com/turbostarter/loading-ui/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turbostarter/loading-ui.git"
  },
  "scripts": {
    "build": "bun run build:colors && next build",
    "build:colors": "bun scripts/build-colors.mts",
    "predev": "bun run build:colors",
    "dev": "next dev",
    "start": "next start",
    "postinstall": "fumadocs-mdx && next typegen && bun run build:colors",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "build:registry": "bun registry/scripts/build.mts && bun format:fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@octokit/rest": "^22.0.1",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "envin": "^1.2.0",
    "fumadocs-core": "16.14.0",
    "fumadocs-mdx": "15.2.1",
    "fumadocs-ui": "16.14.0",
    "geist": "^1.7.2",
    "jotai": "^2.20.2",
    "lru-cache": "^11.5.2",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-pretty-code": "^0.14.5",
    "shadcn": "^4.16.0",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "ts-morph": "^26.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2"
  }
}
