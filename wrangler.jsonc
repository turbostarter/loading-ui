{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loading-ui",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "preview_urls": true,
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "NODE_ENV": "production",
    "SITE_URL": "https://loading-ui.com",
    "VITE_POSTHOG_PROJECT_TOKEN": "phc_L5JfVUDLqndka7zpFtvmXCLjlGCDCvgqVnOwHUEnPpI",
    "VITE_POSTHOG_HOST": "/ingest",
    "POSTHOG_HOST": "https://us.i.posthog.com",
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/docs", "/docs/*", "/api/*", "/ingest", "/ingest/*"],
  },
  "routes": [{ "pattern": "loading-ui.com", "custom_domain": true }],
}
