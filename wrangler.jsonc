{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loading-ui",
  // Set this to today's date
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "preview_urls": true,
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "NODE_ENV": "production",
    "SITE_URL": "https://loading-ui.com",
  },
  // Serve hashed client assets and the shadcn registry as static files.
  // Run the Worker first on docs so Accept: text/markdown negotiation still works.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/docs", "/docs/*", "/api/*"],
  },
  // Uncomment after the loading-ui.com zone is Active in this Cloudflare account.
  // Adding these before the zone exists will fail `wrangler deploy`.
  // "routes": [
  //   { "pattern": "loading-ui.com", "custom_domain": true },
  //   { "pattern": "www.loading-ui.com", "custom_domain": true }
  // ]
}
